# Copy to .env and fill in values.

# Telegram bot (optional — see README "Telegram bot"). If TELEGRAM_BOT_TOKEN
# is left blank, run_scheduler.py falls back to a plain, non-Telegram loop.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id — required if TELEGRAM_BOT_TOKEN is set.
# Manages the allowlist (/admin_add, /admin_remove, /admin_list) and always
# receives push notifications. Get your id from @userinfobot on Telegram.
ADMIN_USER_ID=
# Optional: comma-separated Telegram user ids also allowed to use the bot
# and who also receive push notifications (unioned with the bot-managed
# list added via /admin_add). Leave blank + no bot-managed ids = open to
# any Telegram user.
ALLOWED_USER_IDS=

# Optional SMTP email alert (see notifications/live_signal_email.py) — not
# wired into run_scheduler.py by default; Telegram above is the primary
# notification path.
TRADE_PILOT_SMTP_HOST=smtp.gmail.com
TRADE_PILOT_SMTP_PORT=587
TRADE_PILOT_SMTP_USER=your@gmail.com
TRADE_PILOT_SMTP_PASSWORD=your-gmail-app-password
TRADE_PILOT_EMAIL_TO=recipient@gmail.com
TRADE_PILOT_EMAIL_FROM=
